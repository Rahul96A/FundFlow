# Copy to `.env` (git-ignored) before running `docker compose up`.
# These are LOCAL DEVELOPMENT values only. Never reuse them anywhere shared, and never commit a real .env.

# --- SQL Server ---------------------------------------------------------------------------------------------
# SA password: 8+ chars with upper, lower, digit and symbol (SQL Server enforces its own complexity rules).
MSSQL_SA_PASSWORD=FundFlow_Dev#2026
# Password of the least-privilege `fundflow_app` login the API connects with.
MSSQL_APP_PASSWORD=FundFlow_App#2026

# --- Redis / RabbitMQ ---------------------------------------------------------------------------------------
REDIS_PASSWORD=fundflow_redis_dev
RABBITMQ_USER=fundflow
RABBITMQ_PASSWORD=fundflow_dev

# --- API ----------------------------------------------------------------------------------------------------
# HMAC key for access tokens; must be 32+ characters. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=development-only-signing-key-do-not-use-in-production-0123456789
# Create the demo organizations (Hope Foundation, Riverside Animal Rescue) on first start.
SEED_DEMO_DATA=true

# --- Host ports (change if something on your machine already uses them) -----------------------------------
WEB_PORT=3000
API_PORT=5080
SQLSERVER_PORT=1433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
