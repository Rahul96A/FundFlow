{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System": "Warning",
        "Hangfire": "Information",
        "MassTransit": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "App": {
    "PublicBaseUrl": "http://localhost:3000",
    "ProductName": "FundFlow",
    "SupportEmail": "support@fundflow.example"
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenSlidingLifetimeDays": 14,
    "RefreshTokenAbsoluteLifetimeDays": 30,
    "RefreshReuseGraceSeconds": 10,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "RequireConfirmedEmail": true,
    "EmailVerificationTokenHours": 48,
    "PasswordResetTokenMinutes": 60,
    "InvitationTokenDays": 7
  },
  "Jwt": {
    "Issuer": "https://api.fundflow.com",
    "Audience": "fundflow-web",
    "SigningKey": ""
  },
  "Security": {
    "PasswordHashIterations": 210000
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@fundflow.example",
    "FromName": "FundFlow"
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": ""
  },
  "Hangfire": {
    "Enabled": true,
    "PrepareSchema": false,
    "WorkerCount": 4
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDemoData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 20,
    "SensitivePerMinute": 10,
    "GlobalPerMinute": 600
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "Https": {
    "Redirect": false
  },
  "Swagger": {
    "Enabled": false
  }
}
